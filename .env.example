# Neon Postgres connection string (use the POOLED connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWT tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (Render sets this automatically)
PORT=3000

# Credentials seeded into the users table (used by POST /api/auth/login)
SEED_USER_EMAIL=admin@bookmarkly.dev
SEED_USER_PASSWORD=password123
SEED_USER_NAME=Anton
